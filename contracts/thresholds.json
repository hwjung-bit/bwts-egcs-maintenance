      "TTurb":     {"cal": 48, "repl": 96},
      "TpH-D":     {"cal": 24, "repl": 24},
      "G6110":     {"cal": 24, "repl": 48},
      "G6111":     {"cal": 36, "repl": 36},
      "G6120":     {"cal": null, "repl": 60},
      "G6130":     {"cal": 12, "repl": 12}
    },
    "_doc": "WMS 센서 모델별 검교정(cal)/신환(repl) 주기. WMS 매뉴얼 2026.06.18. cal null = 검교정 없음(신환만)"
  },

  "bwts_log": {
    "tro_ballast_min_ppm": 5.0,
    "tro_ballast_max_ppm": 10.0,
    "tro_ballast_relaxed_max_ppm": 12.0,
    "tro_ballast_relaxed_ratio": 0.5,
    "tro_ballast_relaxed_min_rows": 10,
    "tro_deballast_max_ppm": 0.1,
    "tro_deballast_month_avg_max_ppm": 0.2,
    "tro_appear_threshold_ppm": 0.1,
    "warmup_rows": 5,
    "session_gap_minutes": 10,
    "trip_check_needed": 3,
    "chatter_interval_sec": 30,
    "chatter_min_burst_events": 6,
    "recovery_split_day": 15,
