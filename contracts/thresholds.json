  },

  "integrity": {
    "csv_min_bytes_for_content": 20480,
    "history_months": 6,
    "history_min_operating_months": 5,
    "eventlog_grep_pattern": "BALLAST|DEBALLAST|START|STOP",
    "_doc": "판독실패(검토필요) 판정. I3 파일크기, I4 원문 grep, I6 이력 대비"
  },

  "mail": {
